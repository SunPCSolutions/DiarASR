# Environment variables for diarasr API service

# API Keys for authentication (comma-separated list)
API_KEYS=12309asdhbeq123

# Hugging Face token for accessing private models (required for Pyannote diarization)
HF_TOKEN=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

# Hugging Face cache directory
HF_HOME=/home/app/.cache/huggingface

# Lhotse cache directory
LHOTSE_CACHE_DIR=/app/tmp
LHT_CACHE_DIR=/app/tmp

# XDG cache directory
XDG_CACHE_HOME=/tmp

# Matplotlib config directory
MPLCONFIGDIR=/tmp/matplotlib

# Temp directory
TMPDIR=/app/tmp

# Logging level
LOG_LEVEL=INFO

# Maximum file size for uploads (MB)
MAX_FILE_SIZE_MB=100

# Legacy model references (no longer used - system uses fixed models)
# ASR_MODEL=nvidia/parakeet-tdt-1.1b (automatically selected)
# DIARIZATION_MODEL=pyannote/speaker-diarization-community-1 (automatically selected)# Disable HuggingFace telemetry for maximum privacy
HF_HUB_DISABLE_TELEMETRY=1
